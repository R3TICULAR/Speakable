{
  "name": "@reticular/speakable",
  "version": "1.6.0",
  "description": "CLI tool for analyzing HTML accessibility announcements",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storybook": "./dist/storybook/preset.js"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "speakable": "dist/cli.js",
    "speakable-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsup && npm run build:addon",
    "build:addon": "npm run build --prefix addon-speakable && cp -r addon-speakable/dist dist/storybook",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "npm run build --prefix addon-speakable && concurrently -n addon,storybook -c blue,magenta \"npm run dev --prefix addon-speakable\" \"storybook dev -p 6006\"",
    "build-storybook": "storybook build",
    "test:a11y": "node --loader ts-node/esm stories/speakable-test.ts",
    "test:a11y:ci": "vitest run tests/multiselect-a11y.test.ts"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "screen-reader",
    "aria",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/R3TICULAR/AnnounceKit.git"
  },
  "homepage": "https://getspeakable.dev",
  "bugs": {
    "url": "https://github.com/R3TICULAR/AnnounceKit/issues"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/html": "^8.6.18",
    "@storybook/html-vite": "^8.6.18",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "concurrently": "^10.0.4",
    "fast-check": "^3.15.0",
    "storybook": "^8.6.18",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^11.1.0",
    "jsdom": "^23.0.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "storybook": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "storybook": {
      "optional": true
    }
  }
}
