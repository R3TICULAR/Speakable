{
  "name": "@reticular/speakable",
  "version": "1.4.0",
  "description": "CLI tool for analyzing HTML accessibility announcements",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "speakable": "dist/cli.js",
    "speakable-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "screen-reader",
    "aria",
    "cli",
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/R3TICULAR/AnnounceKit.git"
  },
  "homepage": "https://getspeakable.dev",
  "bugs": {
    "url": "https://github.com/R3TICULAR/AnnounceKit/issues"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "fast-check": "^3.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^11.1.0",
    "jsdom": "^23.0.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.0"
  }
}
